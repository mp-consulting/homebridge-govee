{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "homebridge-ui/server.js",
    "scripts/*.js"
  ],
  "project": [
    "src/**/*.ts",
    "homebridge-ui/*.js",
    "scripts/**/*.js",
    "test/**/*.ts"
  ],
  "ignoreDependencies": [
    "bootstrap",
    "bootstrap-icons",
    "homebridge-config-ui-x",
    "class-transformer",
    "class-validator",
    "@homebridge/hap-nodejs"
  ]
}
